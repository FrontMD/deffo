mixin catalog-category(props= defaultCatalogCategoryProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultCatalogCategoryProps.classes,
            cards: props.cards ? props.cards : defaultCatalogCategoryProps.cards,
        }

    section.catalog-category.section.section--inner(class= checkProps.classes)&attributes(attributes)
        .d-container
            .catalog-category__layout
                .catalog-category__sidebar.catalog-sidebar(data-js="catalogSidebar")
                    .catalog-sidebar__filter-btn(data-js="catalogSidebarFilterOpen" data-aos-delay="200" data-aos="fade-right" data-aos-duration="1000" data-aos-anchor-placement='top-bottom')
                        svg
                            use(xlink:href=`img/sprites/sprite.svg#filter`)

                    form.catalog-filter(action="#" data-js="catalogSidebarCatalogFilter" data-aos-delay="200" data-aos="fade-right" data-aos-duration="1000" data-aos-anchor-placement='top-bottom')
                        .catalog-sidebar__block
                            .catalog-sidebar__title Новинка
                            .checkbox-list
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Только новинки',
                                    inputAttr: {
                                        name: 'new'
                                    }
                                })
                        .catalog-sidebar__block
                            .catalog-sidebar__title Категории
                            .checkbox-list
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Фасады базовые',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Интегрированная ручка',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Фасады под стекло №1',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Фасады под стекло №2',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Фасады под стекло №3',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Фасады под стекло №4',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })
                                +field({
                                    type: 'checkbox',
                                    checkboxText: 'Фасады с решеткой',
                                    inputAttr: {
                                        name: 'category'
                                    }
                                })

                    .catalog-sidebar__block(data-aos="fade-right" data-aos-delay="200" data-aos-duration="1000" data-aos-anchor-placement='top-bottom')
                        .catalog-sidebar__title Не нашли нужное?
                        +form({
                            btnText: 'Заказать звонок',
                            btnCMode: 'full',
                            text: 'Свяжитесь с нашим менеджером и он предложит Вам варианты.',
                            privacyText: 'Я прочитал и согласен с <a href="javascript:void(0);" target="_blank">политикой</a> в отношении обработки персональных данных',
                            design2: true,
                        })
                            +field({
                                placeholder: 'Ваше имя',
                                inputAttr: {
                                    'required': '',
                                    'data-type': 'letters'
                                },
                                hasError: true
                            })
                            +field({
                                placeholder: 'Телефон',
                                type: 'tel',
                                inputAttr: {
                                    'data-type': 'phoneNumber',
                                    'required': '',
                                    'data-v-name': 'phone'
                                },
                                hasError: true
                            })

                .catalog-category__main
                    +prods-list({
                        inner: true,
                        hasPagination: true,
                        cards: checkProps.cards
                    })