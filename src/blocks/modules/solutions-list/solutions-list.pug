mixin solutions-list(props= defaultSolutionsListProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultSolutionsListProps.classes,
            cards: props.cards ? props.cards : defaultSolutionsListProps.cards,
        }

    section.solutions-list.section.section--inner(class= checkProps.classes)&attributes(attributes)
        .d-container
            .solutions-list__items
                - let cardsCount = 0
                - let cardsList = checkProps.cards
                - while(cardsCount < cardsList.length)
                    +solutions-item(cardsList[cardsCount])()

                    - cardsCount++

            .solutions-list__controls
                +pagination