-
    const defaultSTitleProps = {
        classes: '',
        title: '',
        text: '',
        hasFilter: false
    }

mixin s-title(props = defaultSTitleProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultSTitleProps.classes,
            title: props.title ? props.title : defaultSTitleProps.title,
            text: props.text ? props.text : defaultSTitleProps.text,
            hasFilter: props.hasFilter ? props.hasFilter : defaultSTitleProps.hasFilter
        }

    section.section.s-title.section--inner(class=checkProps.classes data-js="sTitle" data-anim-id="sTitle")&attributes(attributes)
        div(data-js="scrollTrigger" data-aos="fade-up" data-aos-duration="50" data-aos-anchor="[data-anim-id='sTitle']" data-aos-anchor-placement="top-center")
        .d-container
            .s-title__container
                - if(checkProps.title.length > 0)
                    div(data-js="sTitleTitle" data-anim-type='opacity')
                        +title({
                            classes: 's-title__title',
                            text: checkProps.title,
                            tag: 'h2',
                            size: '40',
                            animColor: true
                        })
                - if(checkProps.text.length > 0)
                    .s-title__text.text-editor(data-aos="fade-right" data-aos-duration="1000" data-aos-anchor='[data-js="sTitle"]' data-aos-anchor-placement='top-center')!= checkProps.text
            - if(checkProps.hasFilter === true)
                .s-title__filter.catalog-filter(data-aos="fade-up" data-aos-duration="600" data-aos-delay="500" data-aos-anchor='[data-js="sTitle"]' data-aos-anchor-placement='top-center')
                    form.catalog-filter__form(action="#")
                        +field({
                            tag: 'select',
                            placeholder: 'Категория',
                            selectOptions: [
                                {
                                    value: 'Виды продукции',
                                    isActive: true
                                },
                                {
                                    value: 'Декоративные элементы',
                                    isActive: false
                                },
                                {
                                    value: 'Фрезеровки',
                                    isActive: false
                                },
                                {
                                    value: 'Типы покрытия',
                                    isActive: false
                                },
                                {
                                    value: 'Торцы фасадов',
                                    isActive: false
                                },
                                {
                                    value: 'Патина',
                                    isActive: false
                                }
                            ],
                            selectInFilter: true,
                        })
                        .catalog-filter__toggle.filter-toggle
                            +field({
                                type: 'checkbox'
                            })
                            .filter-toggle__text Только новинки
                    +btn({
                        classes: 'catalog-filter__btn',
                        name: 'Не нашли нужное?'
                    })(data-modal="#callbackModal")


