mixin gallery-list(props= defaultGalleryListProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultGalleryListProps.classes,
            cards: props.cards ? props.cards : defaultGalleryListProps.cards
        }

    section.galeery-list.section.section--inner(class= checkProps.classes data-js="galleryList")&attributes(attributes)
        .d-container
            .gallery-list__items(data-js="galleryListGrid")
                - let cardsCount = 0
                - let cardsList = checkProps.cards
                - while(cardsCount < cardsList.length)
                    - cardsList[cardsCount].index = cardsCount
                    +sl-card(cardsList[cardsCount])(data-anim-id="galleryListItem")

                    - cardsCount++

        <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

