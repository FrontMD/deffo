mixin news-list(props= defaultNewsListProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultNewsListProps.classes,
            cards: props.cards ? props.cards : defaultNewsListProps.cards,
        }

    section.news-list.section.section--inner(class= checkProps.classes data-js="newsList")&attributes(attributes)
        .d-container
            .news-list__items
                - let cardsCount = 0
                - let cardsList = checkProps.cards
                - while(cardsCount < cardsList.length)
                    +n-card(cardsList[cardsCount])(data-js="newsListCard")

                    - cardsCount++

            .news-list__controls
                +btn({
                    name: 'Загрузить еще',
                    sMode: 'full',
                    cMode: 'bordered-acc'
                })(data-js="newsListMore")
                +pagination({
                    classes: 'pagination--center'
                })