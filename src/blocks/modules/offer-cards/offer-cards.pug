mixin offer-cards(props= defaultOfferCardsProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultOfferCardsProps.classes,
            rows: props.rows ? props.rows : defaultOfferCardsProps.rows,
        }

    section.offer-cards.section.section--inner(class= checkProps.classes)&attributes(attributes)
        .d-container
            .offer-cards__container
                - let rows = checkProps.rows 
                - let count = 0

                - while(count < rows.length)

                    - let row = rows[count]
                    - let dirClass = row.imgRight === true ? 'offer-cards__row--reverse' : ''

                    .offer-cards__row(class=dirClass data-aos=`fade-up` data-aos-duration="600" data-aos-anchor-placement="top-bottom")
                        .offer-cards__img(data-aos=`${row.imgRight === true ? 'fade-left' : 'fade-right'}` data-aos-duration="600" data-aos-delay="300" data-aos-anchor-placement="top-bottom")
                            img(src=row.img, alt="")
                        .offer-cards__info
                            +title({
                                classes: 'offer-cards__title',
                                text: row.title,
                                size: '40'
                            })(data-aos='fade-up' data-aos-duration="600" data-aos-delay="100" data-aos-anchor-placement="bottom-bottom")
                            .offer-cards__text.text-editor(data-aos='fade-up' data-aos-duration="600" data-aos-delay="300" data-aos-anchor-placement="top-bottom")!= row.text
                            - if(row.btns !== false)
                                .offer-cards__btns
                                    - let btnsCount = 0
                                    - let btnsList = row.btns 
                                    - while(btnsCount < btnsList.length) 
                                        +btn(btnsList[btnsCount])(data-aos='fade-up' data-aos-duration="600" data-aos-delay="300" data-aos-anchor-placement="bottom-bottom")

                                        - btnsCount++
                    - count++
