-
    const defaultNotFoundProps = {
        classes: ''
    }

mixin not-found(props = defaultNotFoundProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultNotFoundProps.classes,
        }

    section.section.section--inner.section--fh.not-found(class= checkProps.classes)&attributes(attributes)
        .d-container.not-found__content
            +title({
                classes: 'not-found__title',
                text: '404',
                size: '60'
            })(data-aos="fade-up")
            +title({
                classes: 'not-found__subtitle',
                text: 'Страница не найдена!',
                size: '40'
            })(data-aos="fade-up" data-aos-delay="200")
            +btn({
                name: 'На главную'
            })(data-aos="fade-up" data-aos-delay="400")