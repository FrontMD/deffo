-
    const defaultProdsListProps = {
        classes: '',
        title: '',
        hasPagination: false,
        inner: false,
        cards: [
            {
                title: 'Фасад прямой с решеткой №3',
                img: 'img/catalog/prod_1.webp'
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №3',
                img: 'img/catalog/prod_2.webp',
                tags: [
                    {
                        text: 'Распродажа',
                        icon: 'img/catalog/tag_sale.svg'
                    }
                ]
            },
            {
                title: 'Фасад прямой с решеткой №1',
                img: 'img/catalog/prod_3.webp',
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №4',
                img: 'img/catalog/prod_1.webp',
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №5 (3*2)',
                img: 'img/catalog/prod_2.webp',
                tags: [
                    {
                        text: 'Новинка',
                        icon: 'img/catalog/tag_new.svg'
                    }
                ]
            },
            {
                title: 'Фасад прямой с решеткой №2',
                img: 'img/catalog/prod_3.webp',
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №6',
                img: 'img/catalog/prod_1.webp',
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №3',
                img: 'img/catalog/prod_2.webp',
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №6',
                img: 'img/catalog/prod_3.webp',
            },
            {
                title: 'Фасад прямой под стекло 3 ВД №5 (3*2)',
                img: 'img/catalog/prod_1.webp',
                tags: [
                    {
                        text: 'Новинка',
                        icon: 'img/catalog/tag_new.svg'
                    }
                ]
            },
        ]
    }

mixin prods-list(props= defaultProdsListProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultProdsListProps.classes,
            title: props.title ? props.title : defaultProdsListProps.title,
            hasPagination: props.hasPagination ? props.hasPagination : defaultProdsListProps.hasPagination,
            inner: props.inner ? props.inner : defaultProdsListProps.inner,
            cards: props.cards ? props.cards : defaultProdsListProps.cards,
        }

    - if(checkProps.inner === true)
        .prods-list.prods-list--inner(class= checkProps.classes data-js="prodsList")&attributes(attributes)
            .prods-list__items(data-js="prodsList")
                - let cardsCount = 0
                - let cardsList = checkProps.cards
                - while(cardsCount < cardsList.length)
                    +prod-card(cardsList[cardsCount])

                    - cardsCount++

            - if(checkProps.hasPagination === true)
                +pagination({
                    classes: 'prods-list__pagination'
                })

    - else
        section.prods-list.section.section--inner(class= checkProps.classes data-js="prodsList")&attributes(attributes)
            .d-container
                - if(checkProps.title.length > 0)
                    div(data-js="scrollTrigger") 
                    div(class="prods-list__title" data-js="prodsListTitle" data-anim-type='opacity') 
                        +title({
                            text: checkProps.title,
                            tag: 'h2',
                            size: '26',
                            animColor: true
                        })

                .prods-list__items(data-js="prodsList")
                    - let cardsCount = 0
                    - let cardsList = checkProps.cards
                    - while(cardsCount < cardsList.length)
                        +prod-card(cardsList[cardsCount])

                        - cardsCount++

                - if(checkProps.hasPagination === true)
                    +pagination({
                        classes: 'prods-list__pagination'
                    })