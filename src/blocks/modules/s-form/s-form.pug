-
    const defaultSFormProps = {
        classes: '',
    }

mixin s-form(props= defaultSFormProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultSFormProps.classes
        }

    section.s-form.section.section--inner(class= checkProps.classes data-anim-id="sForm")&attributes(attributes)  
        .d-container
            .s-form__content
                .s-form__decor(data-aos="fade-up" data-aos-duration="600" data-aos-delay="1400" data-aos-anchor="[data-anim-id='sForm']" data-aos-anchor-placement="top-bottom")
                    img(src="img/contacts/contacts_form.webp" alt="")
                .s-form__info
                    +title({
                        classes: 's-form__title',
                        text: 'Возникли вопросы?',
                        tag: 'h2',
                        size: '30'
                    })(data-aos="fade-right" data-aos-duration="1000" data-aos-delay="400" data-aos-anchor="[data-anim-id='sForm']" data-aos-anchor-placement="top-bottom")
                    .s-form__text.text-editor(data-aos="fade-right" data-aos-duration="1000" data-aos-delay="600" data-aos-anchor="[data-anim-id='sForm']" data-aos-anchor-placement="top-bottom")
                        p Заполните форму <br>и мы с вами свяжемся

                .s-form__form(data-aos="fade-up" data-aos-duration="1000" data-aos-delay="1000" data-aos-anchor="[data-anim-id='sForm']" data-aos-anchor-placement="top-bottom")
                    +form({
                        btnText: 'Заказать звонок',
                        btnCMode: 'accent',
                        privacyText: 'Я прочитал и согласен с <a href="javascript:void(0);" target="_blank">политикой</a> в отношении обработки персональных данных',
                        design2: true,
                    })(data-ajax-form-inline method="post")
                        +field({
                            placeholder: 'Ваше имя',
                            inputAttr: {
                                'required': '',
                                'data-type': 'letters'
                            },
                            hasError: true
                        })
                        +field({
                            placeholder: 'Телефон',
                            type: 'tel',
                            inputAttr: {
                                'data-type': 'phoneNumber',
                                'required': '',
                                'data-v-name': 'phone'
                            },
                            hasError: true
                        })
