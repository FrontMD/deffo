-
    const defaultTooltipProps = {
        classes: '',
        text: 'Аттестат выдает партнер гимназии',
        icon: 'img/tooltip.svg'
    }

mixin tooltip(props= defaultTooltipProps)
    -
        const checkProps = {
            classes: props.classes ? props.classes : defaultTooltipProps.classes,
            text: props.text ? props.text : defaultTooltipProps.text,
            icon: props.icon ? props.icon : defaultTooltipProps.icon
        }

    .tooltip(class= checkProps.classes data-js="tooltip")&attributes(attributes)
        .tooltip__tooltip(data-js="tooltipTooltip")!= checkProps.text
        .tooltip__icon
            img(src=checkProps.icon)